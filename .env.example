# Copy to .env. Defaults match docker-compose.yml when the API runs on the host.

# LLM provider: groq or anthropic. If unset, groq is used when only GROQ_API_KEY is present.
LLM_PROVIDER=groq
GROQ_API_KEY=
ANTHROPIC_API_KEY=
# Defaults: openai/gpt-oss-120b (groq), claude-opus-5-5 (anthropic)
LLM_MODEL=
# groq gpt-oss: low | medium | high; anthropic: low | medium | high | xhigh | max
LLM_SQL_EFFORT=medium
LLM_SUMMARY_EFFORT=low

# LLM-generated SQL runs as this role (SELECT-only). Never point it at a superuser.
DATABASE_URL=postgresql+psycopg://analytics_ro:analytics_ro@localhost:5434/analytics
# Trace logging role (can only write ops.query_traces). Leave empty to disable tracing.
TRACE_DATABASE_URL=postgresql+psycopg://app_logger:app_logger@localhost:5434/analytics
# Only used by scripts/seed.py.
DATABASE_ADMIN_URL=postgresql://postgres:postgres@localhost:5434/analytics

STATEMENT_TIMEOUT_MS=10000
MAX_ROWS=1000
ROWS_IN_RESPONSE=500
# Example rows per table shown to the LLM. Set 0 if tables hold sensitive data.
SAMPLE_ROWS_PER_TABLE=3
MAX_LOOKUP_CALLS=4
DB_SCHEMAS=public

# Public-demo protection (0 disables). Questions per client per window, and a global daily cap.
RATE_LIMIT_PER_CLIENT=20
RATE_LIMIT_WINDOW_S=3600
DAILY_QUESTION_CAP=0
# When set, GET /traces requires the header X-Admin-Token: <value>.
ADMIN_TOKEN=
